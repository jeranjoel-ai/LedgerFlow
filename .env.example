# Copy this file to .env and fill in real values. NEVER commit the real .env file.

# --- PostgreSQL ---
DB_USERNAME=ledgerflow
DB_PASSWORD=change-me-locally

# --- Kafka (KRaft mode) ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Keycloak ---
KEYCLOAK_BASE_URL=http://localhost:8180
KEYCLOAK_REALM=ledgerflow
KEYCLOAK_CLIENT_ID=ledgerflow-frontend
KEYCLOAK_CLIENT_SECRET=change-me-locally

# --- Mailpit (local SMTP) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- Spring AI / LLM provider (switchable by config only) ---
# One of: gemini | groq | ollama
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Config Server (Git-backed) ---
CONFIG_REPO_URI=file://${PWD}/config-repo
